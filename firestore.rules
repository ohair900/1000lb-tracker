rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function crewDoc(crewId) {
      return get(/databases/$(database)/documents/crews/$(crewId)).data;
    }

    // ------------------------------------------------------------------
    // users/{uid}/... — private per-user data (entries, settings sync, …)
    // ------------------------------------------------------------------
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // leaderboard/{uid} — self-reported totals, validated + explicit opt-in
    //
    // The client only writes this doc when the user has explicitly opted in
    // (settings toggle, default OFF). Rules additionally require
    // optedIn == true and sanity-check the numbers so junk/fantasy totals
    // are rejected server-side.
    // ------------------------------------------------------------------
    match /leaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.optedIn == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.squat is number
        && request.resource.data.squat >= 0
        && request.resource.data.squat <= 1200
        && request.resource.data.bench is number
        && request.resource.data.bench >= 0
        && request.resource.data.bench <= 1200
        && request.resource.data.deadlift is number
        && request.resource.data.deadlift >= 0
        && request.resource.data.deadlift <= 1200
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 3000
        && request.resource.data.total
             >= request.resource.data.squat + request.resource.data.bench + request.resource.data.deadlift - 0.01
        && request.resource.data.total
             <= request.resource.data.squat + request.resource.data.bench + request.resource.data.deadlift + 0.01;
      // Opt-out / account cleanup
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // crews/{crewId} — invite-only groups
    //
    // Reads: single-doc get is allowed for any signed-in user because crew
    // IDs are unguessable (`crew_<time>_<rand>`) and the invite code gates
    // discovery via /crewInvites. Collection LIST is members-only so invite
    // codes can't be harvested by scanning.
    // Writes: create locked to owner-as-sole-member with a valid invite
    // code; updates allow self-join (adds only self, capacity enforced),
    // self-leave (removes only self, owner hands off to a remaining member),
    // or member metadata edits that leave membership/ownership/code alone.
    // Delete only when the last member leaves.
    // ------------------------------------------------------------------
    match /crews/{crewId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 8
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // — Self-join: adds ONLY themselves; crew not full; core fields fixed.
        (
          !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && resource.data.memberUids.size() < 20
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.name == resource.data.name
        ) || (
          // — Self-leave: removes ONLY themselves. Owner may hand ownership
          //   to a remaining member in the same write.
          !(request.auth.uid in request.resource.data.memberUids)
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && resource.data.memberUids.size() == request.resource.data.memberUids.size() + 1
          && (
            request.resource.data.ownerUid == resource.data.ownerUid
            || (
              resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid in request.resource.data.memberUids
            )
          )
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.name == resource.data.name
        ) || (
          // — Member metadata (e.g. name change by owner): membership,
          //   ownership and invite code untouched.
          request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
        )
      );

      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.memberUids.size() == 1;
    }

    // ------------------------------------------------------------------
    // crewInvites/{code} — invite-code → crewId lookup. The code IS the
    // secret: any signed-in user who knows a code may resolve it. Creates
    // are open (code is unguessable); later writes need crew membership.
    // ------------------------------------------------------------------
    match /crewInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.crewId is string
        && request.resource.data.keys().hasOnly(['crewId'])
        && crewDoc(request.resource.data.crewId).ownerUid == request.auth.uid;
      allow update, delete: if signedIn()
        && request.auth.uid in crewDoc(resource.data.crewId).memberUids;
    }

    // ------------------------------------------------------------------
    // sharedWorkouts/{shareCode} — real-time co-training lobby
    //
    // Host has full control (session structure, status, completion).
    // Non-host members may ONLY (a) join: add themselves to memberUids and
    // create their own members/{uid} entry, or (b) push presence: update
    // their own members/{uid} cursor fields. hostUid, session, mainLift,
    // status and other members' entries are immutable to non-hosts.
    // Delete stays host-only.
    // ------------------------------------------------------------------
    match /sharedWorkouts/{shareCode} {
      // Read: any signed-in user (share code acts as the secret; needed for
      // existence checks during code generation and join-before-member reads)
      allow read: if signedIn();

      // Create: signed-in user must be the designated host, as sole member
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.hostUid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn() && (
        // — Host: full control.
        request.auth.uid == resource.data.hostUid
        || (
          // — Partner: presence + self-join only.
          request.auth.uid in resource.data.memberUids
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberUids', 'updatedAt'])
          && (
            request.resource.data.memberUids == resource.data.memberUids
            || (
              !(request.auth.uid in resource.data.memberUids)
              && request.auth.uid in request.resource.data.memberUids
              && request.resource.data.memberUids.hasAll(resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            )
          )
          && request.resource.data.members is map
          && resource.data.members is map
          && request.resource.data.members.diff(resource.data.members).affectedKeys()
               .hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] is map
          && request.resource.data.members[request.auth.uid].role == 'partner'
        )
      );

      // Delete: host only (TTL policy handles the 24h auto-delete)
      allow delete: if signedIn()
        && request.auth.uid == resource.data.hostUid;
    }
  }
}
